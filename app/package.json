{
  "name": "resenha",
  "productName": "Resenha",
  "version": "1.3.2",
  "private": true,
  "description": "Voz, chat e compartilhamento de tela pro grupo",
  "author": "Lucas Reis",
  "homepage": "https://github.com/LucasLomiento",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json --threshold error",
    "dist:arch": "electron-vite build && electron-builder --linux pacman",
    "dist:appimage": "electron-vite build && electron-builder --linux AppImage",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "e2e": "VITE_DEFAULT_SERVER=http://127.0.0.1:${RESENHA_E2E_PORT:-8797} electron-vite build && node test/e2e.mjs",
    "dist:win:zip": "electron-vite build && electron-builder --win zip",
    "test:mic": "node --test test/mic-worklet.test.mjs",
    "test:ui": "node --test test/markdown.test.mts test/sdp.test.mts test/settings-search.test.mts",
    "proto:shots": "electron-vite build && node test/proto-shots.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@lucide/svelte": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.19.1",
    "@vencord/venmic": "7.2.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "maplibre-gl": "^6.13.0",
    "playwright-core": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.lucasreis.resenha",
    "productName": "Resenha",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Resenha",
        "schemes": [
          "resenha"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Resenha-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resenha",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Resenha-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Voz, chat e tela pro grupo",
      "maintainer": "Lucas Reis <lucasreistuff@gmail.com>",
      "artifactName": "Resenha-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "Resenha"
        }
      },
      "extraResources": [
        {
          "from": "../node_modules/@vencord/venmic/prebuilds/venmic-addon-linux-x64/node-napi-v7.node",
          "to": "venmic-x64.node"
        },
        {
          "from": "resources/ink-overlay.py",
          "to": "ink-overlay.py"
        }
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libsecret",
        "libxss",
        "libxtst",
        "xdg-utils",
        "pipewire",
        "gtk4",
        "gtk4-layer-shell",
        "python-gobject"
      ]
    },
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "*.png"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LucasLomiento",
        "repo": "resenha",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
